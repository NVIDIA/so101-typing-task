+def sync_warp_default_device(device_str: str) -> None:
+    """Align Warp's default device with a per-rank ``torch.cuda.set_device`` selection.
+
+    In distributed (multi-GPU) runs each process binds a single GPU (``cuda:<local_rank>``). If Warp's
+    runtime was initialized *before* that binding (e.g. ``wp.init()`` ran while the process still
+    defaulted to ``cuda:0``), Warp keeps ``cuda:0`` as its default device. Newton/MJWarp CUDA-graph
+    capture then allocates on the wrong device on non-zero ranks and fails with
+    ``CUDA error 900: operation not permitted when stream is capturing``.
+
+    Call this right after ``torch.cuda.set_device(device_str)``. It only overrides when Warp is already
+    imported *and* initialized; otherwise Warp picks up the correct device on its own lazy init (the
+    ``torch.cuda.set_device`` above has already run), and we avoid force-initializing Warp in processes
+    that never use it.
+
+    Args:
+        device_str: Target device, e.g. ``"cuda:1"``. Non-CUDA values are ignored.
+    """
+    if "cuda" not in device_str:
+        return
+    warp_module = sys.modules.get("warp")
+    warp_context = sys.modules.get("warp._src.context")
+    if warp_module is not None and warp_context is not None and getattr(warp_context, "runtime", None) is not None:
+        warp_module.set_device(device_str)
+        logger.info("Synced Warp default device to %s (after torch.cuda.set_device).", device_str)
+
+
