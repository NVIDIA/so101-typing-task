+def _indices_to_list(indices: object, length: int | None = None) -> list[int]:
+    """Convert supported index containers to a Python list."""
+    if indices is None:
+        if length is None:
+            raise ValueError("length is required when indices is None")
+        return list(range(length))
+    if isinstance(indices, slice):
+        if length is None:
+            raise ValueError("length is required when indices is a slice")
+        return list(range(length))[indices]
+    if isinstance(indices, torch.Tensor):
+        return [int(value) for value in indices.detach().cpu().tolist()]
+    if isinstance(indices, wp.array):
+        return [int(value) for value in wp.to_torch(indices).detach().cpu().tolist()]
+    return [int(value) for value in indices]
+
+
+def _values_shape(values: object) -> tuple[int, ...] | None:
+    """Return the shape for non-scalar joint values."""
+    if isinstance(values, Real):
+        return None
+    if isinstance(values, torch.Tensor):
+        return tuple(values.shape)
+    if isinstance(values, wp.array):
+        return tuple(wp.to_torch(values).shape)
+    return tuple(np.asarray(values).shape)
+
+
+def _values_to_numpy(values: object, shape: tuple[int, int]) -> np.ndarray:
+    """Convert scalar, torch, Warp, or array-like joint values to a NumPy matrix."""
+    if isinstance(values, Real):
+        return np.full(shape, float(values), dtype=np.float32)
+    if isinstance(values, torch.Tensor):
+        values_np = values.detach().cpu().numpy()
+    elif isinstance(values, wp.array):
+        values_np = wp.to_torch(values).detach().cpu().numpy()
+    else:
+        values_np = np.asarray(values, dtype=np.float32)
+    if values_np.shape != shape:
+        raise ValueError(f"expected viscous_friction values with shape {shape}, got {values_np.shape}")
+    return values_np.astype(np.float32, copy=False)
+
+
+def _write_mujoco_passive_damping(
+    newton_model: object, values: object, joint_ids: object, num_dofs: int, env_ids: object = None
+) -> None:
+    """Write joint viscous friction into Newton/MuJoCo passive damping."""
+    mujoco_ns = getattr(newton_model, "mujoco", None)
+    if mujoco_ns is None or not hasattr(mujoco_ns, "dof_passive_damping"):
+        raise RuntimeError("Newton model has no mujoco.dof_passive_damping for viscous_friction")
+
+    joint_id_list = _indices_to_list(joint_ids, num_dofs)
+    damping = mujoco_ns.dof_passive_damping
+    damping_np = damping.numpy()
+    values_shape = _values_shape(values)
+    values_num_envs = values_shape[0] if values_shape is not None and len(values_shape) == 2 else None
+
+    if damping_np.ndim == 2 and damping_np.shape[1] != 1:
+        num_envs = damping_np.shape[0]
+        dofs_per_env = damping_np.shape[1]
+        damping_view = damping_np
+        is_batched_layout = True
+    else:
+        damping_view = damping_np.reshape(-1)
+        if env_ids is None and values_num_envs is not None:
+            num_envs = values_num_envs
+        else:
+            num_envs = int(damping_view.shape[0] // num_dofs)
+        if num_envs <= 0 or damping_view.shape[0] % num_envs != 0:
+            raise ValueError(f"cannot infer MuJoCo passive damping stride from shape {damping_np.shape}")
+        dofs_per_env = int(damping_view.shape[0] // num_envs)
+        is_batched_layout = False
+
+    env_id_list = _indices_to_list(env_ids, num_envs)
+    values_np = _values_to_numpy(values, (len(env_id_list), len(joint_id_list)))
+
+    if is_batched_layout:
+        for env_i, env_id in enumerate(env_id_list):
+            for local_j, joint_id in enumerate(joint_id_list):
+                damping_view[env_id, joint_id] = values_np[env_i, local_j]
+    else:
+        for env_i, env_id in enumerate(env_id_list):
+            for local_j, joint_id in enumerate(joint_id_list):
+                damping_view[env_id * dofs_per_env + joint_id] = values_np[env_i, local_j]
+    damping.assign(damping_np)
+
