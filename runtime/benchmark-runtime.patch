+from types import SimpleNamespace
+
+import numpy as np
+import torch
+from isaaclab_newton.assets.articulation.articulation import _write_mujoco_passive_damping
+
+
+class _FakeDamping:
+    def __init__(self, values: object) -> None:
+        self._values = np.asarray(values, dtype=np.float32)
+        self.assigned = None
+
+    def numpy(self) -> np.ndarray:
+        return self._values.copy()
+
+    def assign(self, values: object) -> None:
+        self.assigned = np.asarray(values, dtype=np.float32)
+
+
+def test_write_mujoco_passive_damping_updates_batched_layout() -> None:
+    damping = _FakeDamping(np.zeros((2, 3), dtype=np.float32))
+    model = SimpleNamespace(mujoco=SimpleNamespace(dof_passive_damping=damping))
+    values = torch.tensor([[0.2, 0.4], [0.6, 0.8]], dtype=torch.float32)
+
+    _write_mujoco_passive_damping(model, values, [0, 2], num_dofs=3)
+
+    np.testing.assert_allclose(damping.assigned, [[0.2, 0.0, 0.4], [0.6, 0.0, 0.8]])
+
+
+def test_write_mujoco_passive_damping_updates_flat_layout() -> None:
+    damping = _FakeDamping(np.zeros(6, dtype=np.float32))
+    model = SimpleNamespace(mujoco=SimpleNamespace(dof_passive_damping=damping))
+    values = torch.tensor([[0.2, 0.4], [0.6, 0.8]], dtype=torch.float32)
+
+    _write_mujoco_passive_damping(model, values, [0, 2], num_dofs=3)
+
+    np.testing.assert_allclose(damping.assigned, [0.2, 0.0, 0.4, 0.6, 0.0, 0.8])
+
+
+def test_write_mujoco_passive_damping_updates_flat_layout_with_model_stride() -> None:
+    damping = _FakeDamping(np.zeros(10, dtype=np.float32))
+    model = SimpleNamespace(mujoco=SimpleNamespace(dof_passive_damping=damping))
+    values = torch.tensor([[0.2, 0.4], [0.6, 0.8]], dtype=torch.float32)
+
+    _write_mujoco_passive_damping(model, values, [0, 2], num_dofs=3)
+
+    np.testing.assert_allclose(damping.assigned, [0.2, 0.0, 0.4, 0.0, 0.0, 0.6, 0.0, 0.8, 0.0, 0.0])
